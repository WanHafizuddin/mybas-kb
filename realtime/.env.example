# Supabase project dashboard -> Connect -> "Direct connection" tab.
# Direct connection is preferred: collector.py holds one persistent
# connection open for the whole polling loop, which is what direct
# connections (and Supavisor session mode) are for -- NOT the transaction
# pooler (port 6543), which doesn't support prepared statements.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Fallback if your network is IPv4-only and direct connection (IPv6, unless
# you've bought the IPv4 add-on) doesn't reach: dashboard -> Connect ->
# "Session pooler" tab. Still port 5432, still supports a long-lived
# connection with prepared statements.
# DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:CHANGE_ME@aws-REGION.pooler.supabase.com:5432/postgres
