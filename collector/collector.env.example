# /etc/basmy-collector.env on the VM (written by infra/startup.sh.tftpl).
# No secrets: auth is the VM's attached service account.
BASMY_SINK=gcs
BASMY_BUCKET=your-bucket-name
BASMY_FEEDS_CONFIG=/opt/basmy/app/config/feeds.toml
BASMY_SPOOL_DIR=/var/lib/basmy-collector/spool
BASMY_HEALTH_FILE=/var/lib/basmy-collector/health.json
# BASMY_INTERVAL=30
